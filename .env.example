# Spotify OAuth App (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Must match the URL the app is reachable at (use 127.0.0.1, not localhost)
NEXTAUTH_URL=http://127.0.0.1:3000
# Optional: contact (URL or e-mail) sent to MusicBrainz in the User-Agent, as their API rules ask
MUSICBRAINZ_CONTACT=

# Dev server only: further addresses allowed to load it, e.g. a phone in the LAN (comma-separated)
ALLOWED_DEV_ORIGINS=
